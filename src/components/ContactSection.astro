<section id="contact" class="contact-section">
  <div class="contact-section-inner">
    <div class="contact-section-copy">
      <p class="contact-section-eyebrow">Vamos trabalhar juntos</p>
      <h2 class="contact-section-title">Conte-me sobre sua ideia</h2>
      <p class="contact-section-intro">
        Tem um projeto, uma colaboração ou uma história para transformar em imagem?
        Envie uma mensagem e vamos conversar.
      </p>
    </div>

    <form
      class="portfolio-contact-form"
      action="https://formsubmit.co/vitorm2711@gmail.com"
      method="POST"
    >
      <input type="hidden" name="_subject" value="Novo contato pelo portfólio Aukanaii" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="text" name="_honey" class="contact-form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="contact-form-grid">
        <label class="contact-form-field">
          <span>Nome <strong aria-hidden="true">*</strong></span>
          <input type="text" name="nome" autocomplete="name" required />
        </label>

        <label class="contact-form-field">
          <span>E-mail <strong aria-hidden="true">*</strong></span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <label class="contact-form-field">
          <span>Telefone <small>(opcional)</small></span>
          <input type="tel" name="telefone" autocomplete="tel" />
        </label>

        <label class="contact-form-field contact-form-field-message">
          <span>Mensagem <strong aria-hidden="true">*</strong></span>
          <textarea name="mensagem" rows="5" required></textarea>
        </label>
      </div>

      <button type="submit" class="contact-form-submit">Enviar mensagem</button>
    </form>
  </div>
</section>
